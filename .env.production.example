# Copy to .env.production and replace every placeholder with a unique random value.
# Used by Compose to configure PostgreSQL and the public site URL.
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-value
SITE_DOMAIN=sgperf.co.za

# DATABASE_URL is set by docker-compose.production.yml.
PAYLOAD_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
PREVIEW_SECRET=replace-with-a-long-random-secret
